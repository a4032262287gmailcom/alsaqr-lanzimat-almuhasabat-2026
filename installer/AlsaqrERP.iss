; Alsaqr Accounting System - Windows installer
; Generated by the verified Windows Release workflow.

#define MyAppName "الصقر لأنظمة المحاسبة"
#define MyAppVersion "1.0.0"
#define MyAppPublisher "الصقر لأنظمة المحاسبة"
#define MyAppExeName "GTSErpSystem.exe"

[Setup]
AppId={{9D8240C2-7D62-4D31-9F74-6C3A6A4E1026}
AppName={#MyAppName}
AppVersion={#MyAppVersion}
AppPublisher={#MyAppPublisher}
DefaultDirName={autopf}\Alsaqr Accounting System
DefaultGroupName={#MyAppName}
DisableProgramGroupPage=yes
OutputDir=..\artifacts
OutputBaseFilename=AlsaqrERP-Setup-1.0.0
SetupIconFile=..\SourceCode\app.ico
Compression=lzma2
SolidCompression=yes
WizardStyle=modern
ArchitecturesInstallIn64BitMode=x64
PrivilegesRequired=admin
UninstallDisplayName={#MyAppName}
Uninstallable=yes
CloseApplications=force
RestartApplications=no

[Languages]
Name: "arabic"; MessagesFile: "compiler:Languages\Arabic.isl"
Name: "english"; MessagesFile: "compiler:Default.isl"

[Tasks]
Name: "desktopicon"; Description: "إنشاء اختصار على سطح المكتب"; GroupDescription: "اختصارات إضافية:"; Flags: unchecked

[Files]
Source: "..\SourceCode\bin\Release\net48\*"; DestDir: "{app}"; Flags: ignoreversion recursesubdirs createallsubdirs

[Icons]
Name: "{group}\{#MyAppName}"; Filename: "{app}\{#MyAppExeName}"
Name: "{autodesktop}\{#MyAppName}"; Filename: "{app}\{#MyAppExeName}"; Tasks: desktopicon

[Run]
Filename: "{app}\{#MyAppExeName}"; Description: "تشغيل الصقر لأنظمة المحاسبة"; Flags: postinstall nowait skipifsilent; Check: IsDotNet48OrNewer

[Code]
function IsDotNet48OrNewer: Boolean;
var
  Release: Cardinal;
begin
  Result := RegQueryDWordValue(HKLM, 'SOFTWARE\Microsoft\NET Framework Setup\NDP\v4\Full', 'Release', Release) and (Release >= 528040);
end;

function InitializeSetup(): Boolean;
begin
  Result := IsDotNet48OrNewer;
  if not Result then
    MsgBox('يتطلب البرنامج تثبيت Microsoft .NET Framework 4.8 أو أحدث قبل التشغيل. نزّل المتطلب من موقع Microsoft ثم أعد تشغيل المثبّت.', mbError, MB_OK);
end;
