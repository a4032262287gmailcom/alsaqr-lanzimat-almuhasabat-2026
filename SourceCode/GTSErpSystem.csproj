<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">
  <PropertyGroup>
    <AssemblyName>GTSErpSystem</AssemblyName>
    <GenerateAssemblyInfo>False</GenerateAssemblyInfo>
    <OutputType>WinExe</OutputType>
    <UseWindowsForms>True</UseWindowsForms>
    <TargetFramework>net48</TargetFramework>
    <Prefer32Bit>True</Prefer32Bit>
    <GenerateResourceUsePreserializedResources>True</GenerateResourceUsePreserializedResources>
  </PropertyGroup>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
    <CheckForOverflowUnderflow>False</CheckForOverflowUnderflow>
  </PropertyGroup>
  <!--
    The dependency assemblies included with this repository are in the runtime
    payload folder. Keeping their location in one property prevents relative
    HintPath entries from accidentally pointing at empty repository-root paths.
    A licensed development dependency folder can override this property when needed.
  -->
  <PropertyGroup>
    <!--
      Prefer a runtime folder that includes the licensed DevExpress.Images assembly.
      The repository payload may omit that redistributable, while an existing local
      build output or licensed runtime folder can supply it. RuntimeDependencyRoot
      remains overridable with /p:RuntimeDependencyRoot=... .
    -->
    <RuntimeDependencyRoot Condition="'$(RuntimeDependencyRoot)' == '' and Exists('$(MSBuildThisFileDirectory)..\App\SourceCode\bin\Debug\net48\DevExpress.Images.v21.2.dll')">$(MSBuildThisFileDirectory)..\App\SourceCode\bin\Debug\net48</RuntimeDependencyRoot>
    <RuntimeDependencyRoot Condition="'$(RuntimeDependencyRoot)' == '' and Exists('$(MSBuildThisFileDirectory)bin\Debug\net48\DevExpress.Images.v21.2.dll')">$(MSBuildThisFileDirectory)bin\Debug\net48</RuntimeDependencyRoot>
    <RuntimeDependencyRoot Condition="'$(RuntimeDependencyRoot)' == '' and Exists('$(MSBuildThisFileDirectory)bin\Release\net48\DevExpress.Images.v21.2.dll')">$(MSBuildThisFileDirectory)bin\Release\net48</RuntimeDependencyRoot>
    <RuntimeDependencyRoot Condition="'$(RuntimeDependencyRoot)' == ''">$(MSBuildThisFileDirectory)..\App\SourceCode\bin\Debug\net48</RuntimeDependencyRoot>
  </PropertyGroup>
  <PropertyGroup>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <RootNamespace />
  </PropertyGroup>
  <ItemGroup>
    <None Remove="Model1.csdl" />
    <None Remove="Model1.msl" />
    <None Remove="Model1.ssdl" />
    <None Remove="GTSErpSystem.exe.licenses" />
    <EmbeddedResource Include="Model1.csdl" LogicalName="Model1.csdl" />
    <EmbeddedResource Include="Model1.msl" LogicalName="Model1.msl" />
    <EmbeddedResource Include="Model1.ssdl" LogicalName="Model1.ssdl" />
    <EmbeddedResource Include="GTSErpSystem.exe.licenses" LogicalName="GTSErpSystem.exe.licenses" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="Microsoft.Office.Interop.Excel\**" />
    <EmbeddedResource Remove="Microsoft.Office.Interop.Excel\**" />
    <None Remove="Microsoft.Office.Interop.Excel\**" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="System.Resources.Extensions" Version="8.0.0" />
    <PackageReference Include="Microsoft.Office.Interop.Excel" Version="15.0.4795.1001" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="System.Net.Http" />
    <Reference Include="Microsoft.Bcl.AsyncInterfaces">
      <HintPath>$(RuntimeDependencyRoot)\Microsoft.Bcl.AsyncInterfaces.dll</HintPath>
    </Reference>
    <Reference Include="MetroFramework">
      <HintPath>$(RuntimeDependencyRoot)\MetroFramework.dll</HintPath>
    </Reference>
    <Reference Include="System.Management" />
    <Reference Include="DevExpress.XtraEditors.v21.2">
      <HintPath>$(RuntimeDependencyRoot)\DevExpress.XtraEditors.v21.2.dll</HintPath>
    </Reference>
    <Reference Include="System.Xml" />
    <Reference Include="MaterialSkin">
      <HintPath>$(RuntimeDependencyRoot)\MaterialSkin.dll</HintPath>
    </Reference>
    <Reference Include="System.Xml.Linq" />
    <Reference Include="System.Core" />
    <Reference Include="DevExpress.Utils.v21.2">
      <HintPath>$(RuntimeDependencyRoot)\DevExpress.Utils.v21.2.dll</HintPath>
    </Reference>
    <Reference Include="System.Data" />
    <Reference Include="EntityFramework">
      <HintPath>$(RuntimeDependencyRoot)\EntityFramework.dll</HintPath>
    </Reference>
    <Reference Include="Microsoft.Extensions.DependencyInjection">
      <HintPath>$(RuntimeDependencyRoot)\Microsoft.Extensions.DependencyInjection.dll</HintPath>
    </Reference>
    <Reference Include="zxing">
      <HintPath>$(RuntimeDependencyRoot)\zxing.dll</HintPath>
    </Reference>
    <Reference Include="ZatcaIntegrationSDK">
      <HintPath>$(RuntimeDependencyRoot)\ZatcaIntegrationSDK.dll</HintPath>
    </Reference>
    <Reference Include="QRCoder">
      <HintPath>$(RuntimeDependencyRoot)\QRCoder.dll</HintPath>
    </Reference>
    <Reference Include="Twilio">
      <HintPath>$(RuntimeDependencyRoot)\Twilio.dll</HintPath>
    </Reference>
    <Reference Include="Stimulsoft.Report">
      <HintPath>$(RuntimeDependencyRoot)\Stimulsoft.Report.dll</HintPath>
    </Reference>
    <Reference Include="Janus.Windows.GridEX.v4">
      <HintPath>$(RuntimeDependencyRoot)\Janus.Windows.GridEX.v4.dll</HintPath>
    </Reference>
    <Reference Include="Janus.Windows.Common.v4">
      <HintPath>$(RuntimeDependencyRoot)\Janus.Windows.Common.v4.dll</HintPath>
    </Reference>
    <Reference Include="DevExpress.Printing.v21.2.Core">
      <HintPath>$(RuntimeDependencyRoot)\DevExpress.Printing.v21.2.Core.dll</HintPath>
    </Reference>
    <Reference Include="DevExpress.XtraGrid.v21.2">
      <HintPath>$(RuntimeDependencyRoot)\DevExpress.XtraGrid.v21.2.dll</HintPath>
    </Reference>
    <Reference Include="DevExpress.XtraBars.v21.2">
      <HintPath>$(RuntimeDependencyRoot)\DevExpress.XtraBars.v21.2.dll</HintPath>
    </Reference>
    <Reference Include="DevExpress.Xpo.v21.2">
      <HintPath>$(RuntimeDependencyRoot)\DevExpress.Xpo.v21.2.dll</HintPath>
    </Reference>
    <Reference Include="Stimulsoft.Base">
      <HintPath>$(RuntimeDependencyRoot)\Stimulsoft.Base.dll</HintPath>
    </Reference>
    <Reference Include="System.Data.DataSetExtensions" />
    <Reference Include="DevExpress.Data.v21.2">
      <HintPath>$(RuntimeDependencyRoot)\DevExpress.Data.v21.2.dll</HintPath>
    </Reference>
    <Reference Include="Janus.Windows.UI.v4">
      <HintPath>$(RuntimeDependencyRoot)\Janus.Windows.UI.v4.dll</HintPath>
    </Reference>
    <Reference Include="Stimulsoft.Report.Design">
      <HintPath>$(RuntimeDependencyRoot)\Stimulsoft.Report.Design.dll</HintPath>
    </Reference>
    <Reference Include="Stimulsoft.Report.Win">
      <HintPath>$(RuntimeDependencyRoot)\Stimulsoft.Report.Win.dll</HintPath>
    </Reference>
    <Reference Include="WhatsAppApi">
      <HintPath>$(RuntimeDependencyRoot)\WhatsAppApi.dll</HintPath>
    </Reference>
    <Reference Include="DevExpress.XtraNavBar.v21.2">
      <HintPath>$(RuntimeDependencyRoot)\DevExpress.XtraNavBar.v21.2.dll</HintPath>
    </Reference>
    <Reference Include="Newtonsoft.Json">
      <HintPath>$(RuntimeDependencyRoot)\Newtonsoft.Json.dll</HintPath>
    </Reference>
    <Reference Include="DevExpress.XtraTreeList.v21.2">
      <HintPath>$(RuntimeDependencyRoot)\DevExpress.XtraTreeList.v21.2.dll</HintPath>
    </Reference>
    <Reference Include="Microsoft.EntityFrameworkCore">
      <HintPath>$(RuntimeDependencyRoot)\Microsoft.EntityFrameworkCore.dll</HintPath>
    </Reference>
    <Reference Include="Humanizer">
      <HintPath>$(RuntimeDependencyRoot)\Humanizer.dll</HintPath>
    </Reference>
    <Reference Include="System.Configuration" />
    <Reference Include="System.Threading.Tasks.Extensions">
      <HintPath>$(RuntimeDependencyRoot)\System.Threading.Tasks.Extensions.dll</HintPath>
    </Reference>
    <Reference Include="Elegant.Ui.Common">
      <HintPath>$(RuntimeDependencyRoot)\Elegant.Ui.Common.dll</HintPath>
    </Reference>
    <Reference Include="DevExpress.BonusSkins.v21.2">
      <HintPath>$(RuntimeDependencyRoot)\DevExpress.BonusSkins.v21.2.dll</HintPath>
    </Reference>
    <Reference Include="Microsoft.CSharp" />
    <Reference Include="Janus.Data.v4">
      <HintPath>$(RuntimeDependencyRoot)\Janus.Data.v4.dll</HintPath>
    </Reference>
    <Reference Include="DevExpress.Data.Desktop.v21.2">
      <HintPath>$(RuntimeDependencyRoot)\DevExpress.Data.Desktop.v21.2.dll</HintPath>
    </Reference>
    <Reference Include="DevExpress.Images.v21.2">
      <HintPath>$(RuntimeDependencyRoot)\DevExpress.Images.v21.2.dll</HintPath>
      <Private>True</Private>
    </Reference>
    <Reference Include="Microsoft.EntityFrameworkCore.SqlServer">
      <HintPath>$(RuntimeDependencyRoot)\Microsoft.EntityFrameworkCore.SqlServer.dll</HintPath>
    </Reference>
    <Reference Include="Microsoft.EntityFrameworkCore.Relational">
      <HintPath>$(RuntimeDependencyRoot)\Microsoft.EntityFrameworkCore.Relational.dll</HintPath>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <Reference Include="System.Resources.Extensions">
      <HintPath>$(RuntimeDependencyRoot)\System.Resources.Extensions.dll</HintPath>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <None Remove="SERIAL.WAV" />
    <Content Include="SERIAL.WAV">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  <ItemGroup>
    <Reference Include="EntityFramework.SqlServer">
      <HintPath>Libs\EF6\EntityFramework.SqlServer.dll</HintPath>
      <Private>True</Private>
    </Reference>
  </ItemGroup>
  <Target Name="ValidateDevExpressImagesRuntimeDependency" BeforeTargets="ResolveReferences" Condition="'$(DesignTimeBuild)' != 'true'">
    <Error
      Condition="!Exists('$(RuntimeDependencyRoot)\DevExpress.Images.v21.2.dll')"
      Text="Required DevExpress.Images.v21.2.dll was not found in '$(RuntimeDependencyRoot)'. The repository does not include this licensed DevExpress 21.2 runtime DLL. Set /p:RuntimeDependencyRoot to the folder containing the complete, licensed DevExpress runtime assemblies before building." />
  </Target>
</Project>