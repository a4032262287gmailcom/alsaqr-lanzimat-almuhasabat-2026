	private void SetNetAllowances()
	{
		decimal num = Math.Round(Convert.ToDecimal(NetAllowances), 2);
		if (base.Owner != null && base.Owner is FrmPayroll)
		{
			FrmPayroll frmPayroll = (FrmPayroll)base.Owner;
			if (frmPayroll.gridControl1.MainView is GridView gridView)
			{
				CellValueChangedEventArgs e = new CellValueChangedEventArgs(gridView.FocusedRowHandle, gridView.FocusedColumn, num);
				frmPayroll.UpdateAllowancesInGrid(e);
			}
		}
		if (base.Owner != null && base.Owner is FrmPayrollTemp)
		{
			FrmPayrollTemp frmPayrollTemp = (FrmPayrollTemp)base.Owner;
			if (frmPayrollTemp.gridControl1.MainView is GridView gridView2)
			{
				CellValueChangedEventArgs e2 = new CellValueChangedEventArgs(gridView2.FocusedRowHandle, gridView2.FocusedColumn, num);
				frmPayrollTemp.UpdateAllowancesInGrid(e2);
			}
		}
	}

